{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nerea",
  "version": "0.1.0",
  "identifier": "dev.syberfoxx.nerea",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "nerea",
        "width": 940,
        "height": 660,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "resizable": true
      },
      {
        "label": "avatar",
        "url": "avatar.html",
        "width": 176,
        "height": 256,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": true,
        "title": "nerea-avatar"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
