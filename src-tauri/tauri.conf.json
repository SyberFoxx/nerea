{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nerea",
  "version": "0.12.0",
  "identifier": "dev.syberfoxx.nerea",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "avatar",
        "url": "avatar.html",
        "width": 176,
        "height": 256,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": false,
        "visible": true,
        "title": "nerea-avatar"
      },
      {
        "label": "history",
        "title": "nerea historial",
        "width": 900,
        "height": 720,
        "minWidth": 620,
        "minHeight": 420,
        "visible": false,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
