{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nerea",
  "version": "0.1.0",
  "identifier": "dev.syberfoxx.nerea",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "nerea",
        "width": 940,
        "height": 660,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png"]
  }
}
